snippet sieve sieve of Eratosthenes
    static boolean[] sieve(int n) {
        boolean[] isPrime = new boolean[n + 1];
        Arrays.fill(isPrime, true);
        if (n >= 0) isPrime[0] = false;
        if (n >= 1) isPrime[1] = false;
        for (int p = 2; p * p <= n; p++) {
            if (isPrime[p]) {
                for (int i = p * p; i <= n; i += p) isPrime[i] = false;
            }
        }
        return isPrime;
    }

snippet sparsetable Sparse Table for Range Minimum Query (RMQ)
    static class SparseTable {
        private final int[][] st;
        private final int[] lg;

        public SparseTable(int[] arr) {
            int n = arr.length;
            int k = 32 - Integer.numberOfLeadingZeros(n);
            st = new int[k][n];
            lg = new int[n + 1];
            for (int i = 0; i < n; i++) st[0][i] = arr[i];
            for (int j = 1; (1 << j) <= n; j++) {
                for (int i = 0; i + (1 << j) <= n; i++) {
                    st[j][i] = Math.min(st[j - 1][i], st[j - 1][i + (1 << (j - 1))]);
                }
            }
            lg[1] = 0;
            for (int i = 2; i <= n; i++) lg[i] = lg[i / 2] + 1;
        }

        public int queryMin(int l, int r) {
            int j = lg[r - l + 1];
            return Math.min(st[j][l], st[j][r - (1 << j) + 1]);
        }
    }

snippet binary_jump LCA via binary lifting
    static class LCA {
        private final int n, maxLog;
        private final int[][] up;
        private final int[] depth;

        public LCA(List<List<Integer>> adj, int root) {
            this.n = adj.size();
            this.maxLog = 32 - Integer.numberOfLeadingZeros(n);
            this.up = new int[n][maxLog];
            this.depth = new int[n];
            dfs(root, root, adj);
        }

        private void dfs(int u, int p, List<List<Integer>> adj) {
            up[u][0] = p;
            for (int j = 1; j < maxLog; j++) {
                up[u][j] = up[up[u][j - 1]][j - 1];
            }
            for (int v : adj.get(u)) {
                if (v != p) {
                    depth[v] = depth[u] + 1;
                    dfs(v, u, adj);
                }
            }
        }

        public int getLca(int u, int v) {
            if (depth[u] < depth[v]) { int t = u; u = v; v = t; }
            for (int j = maxLog - 1; j >= 0; j--) {
                if (depth[u] - (1 << j) >= depth[v]) u = up[u][j];
            }
            if (u == v) return u;
            for (int j = maxLog - 1; j >= 0; j--) {
                if (up[u][j] != up[v][j]) {
                    u = up[u][j];
                    v = up[v][j];
                }
            }
            return up[u][0];
        }

        public int dist(int u, int v) {
            return depth[u] + depth[v] - 2 * depth[getLca(u, v)];
        }
    }

snippet sssp_djkstra Dijkstra shortest path algorithm
    static class Edge {
        int to;
        long weight;
        Edge(int to, long weight) { this.to = to; this.weight = weight; }
    }

    static long[] dijkstra(int n, List<List<Edge>> adj, int src) {
        long[] dist = new long[n];
        Arrays.fill(dist, Long.MAX_VALUE);
        dist[src] = 0;
        PriorityQueue<long[]> pq = new PriorityQueue<>(Comparator.comparingLong(a -> a[1]));
        pq.add(new long[]{src, 0});

        while (!pq.isEmpty()) {
            long[] cur = pq.poll();
            int u = (int) cur[0];
            long d = cur[1];
            if (d > dist[u]) continue;

            for (Edge e : adj.get(u)) {
                if (dist[u] + e.weight < dist[e.to]) {
                    dist[e.to] = dist[u] + e.weight;
                    pq.add(new long[]{e.to, dist[e.to]});
                }
            }
        }
        return dist;
    }

snippet sssp_bellman_ford Bellman Ford algorithm
    static class Edge {
        int u, v;
        long weight;
        Edge(int u, int v, long weight) { this.u = u; this.v = v; this.weight = weight; }
    }

    static long[] bellmanFord(int n, List<Edge> edges, int src) {
        long[] dist = new long[n];
        Arrays.fill(dist, Long.MAX_VALUE / 2);
        dist[src] = 0;

        for (int i = 0; i < n - 1; i++) {
            for (Edge e : edges) {
                if (dist[e.u] + e.weight < dist[e.v]) {
                    dist[e.v] = dist[e.u] + e.weight;
                }
            }
        }
        return dist;
    }

snippet toposort Topological sort using Kahn algorithm
    static List<Integer> toposort(int n, List<List<Integer>> adj) {
        int[] inDegree = new int[n];
        for (int u = 0; u < n; u++) {
            for (int v : adj.get(u)) inDegree[v]++;
        }
        Queue<Integer> q = new ArrayDeque<>();
        for (int i = 0; i < n; i++) {
            if (inDegree[i] == 0) q.add(i);
        }
        List<Integer> order = new ArrayList<>();
        while (!q.isEmpty()) {
            int u = q.poll();
            order.add(u);
            for (int v : adj.get(u)) {
                if (--inDegree[v] == 0) q.add(v);
            }
        }
        return order.size() == n ? order : Collections.emptyList();
    }

snippet maxflow Dinic max flow algorithm
    static class Dinic {
        static class Edge {
            int to, rev;
            long cap, flow;
            Edge(int to, int rev, long cap) { this.to = to; this.rev = rev; this.cap = cap; }
        }

        private final int n;
        private final List<List<Edge>> adj;
        private final int[] level, ptr;

        public Dinic(int n) {
            this.n = n;
            adj = new ArrayList<>(n);
            for (int i = 0; i < n; i++) adj.add(new ArrayList<>());
            level = new int[n];
            ptr = new int[n];
        }

        public void addEdge(int from, int to, long cap) {
            Edge a = new Edge(to, adj.get(to).size(), cap);
            Edge b = new Edge(from, adj.get(from).size(), 0);
            adj.get(from).add(a);
            adj.get(to).add(b);
        }

        private boolean bfs(int s, int t) {
            Arrays.fill(level, -1);
            level[s] = 0;
            Queue<Integer> q = new ArrayDeque<>();
            q.add(s);
            while (!q.isEmpty()) {
                int v = q.poll();
                for (Edge e : adj.get(v)) {
                    if (e.cap - e.flow > 0 && level[e.to] == -1) {
                        level[e.to] = level[v] + 1;
                        q.add(e.to);
                    }
                }
            }
            return level[t] != -1;
        }

        private long dfs(int v, int t, long pushed) {
            if (pushed == 0 || v == t) return pushed;
            for (int cid = ptr[v]; cid < adj.get(v).size(); ++cid, ++ptr[v]) {
                Edge e = adj.get(v).get(cid);
                int tr = e.to;
                if (level[v] + 1 != level[tr] || e.cap - e.flow == 0) continue;
                long trPushed = dfs(tr, t, Math.min(pushed, e.cap - e.flow));
                if (trPushed == 0) continue;
                e.flow += trPushed;
                adj.get(tr).get(e.rev).flow -= trPushed;
                return trPushed;
            }
            return 0;
        }

        public long maxFlow(int s, int t) {
            long flow = 0;
            while (bfs(s, t)) {
                Arrays.fill(ptr, 0);
                while (true) {
                    long pushed = dfs(s, t, Long.MAX_VALUE);
                    if (pushed == 0) break;
                    flow += pushed;
                }
            }
            return flow;
        }
    }

snippet kmp Knuth-Morris-Pratt string search
    static int[] prefixFunction(String s) {
        int n = s.length();
        int[] pi = new int[n];
        for (int i = 1; i < n; i++) {
            int j = pi[i - 1];
            while (j > 0 && s.charAt(i) != s.charAt(j)) j = pi[j - 1];
            if (s.charAt(i) == s.charAt(j)) j++;
            pi[i] = j;
        }
        return pi;
    }

snippet trie Trie prefix tree
    static class Trie {
        static class Node {
            Node[] next = new Node[26];
            boolean isEnd = false;
        }

        private final Node root = new Node();

        public void insert(String s) {
            Node cur = root;
            for (char c : s.toCharArray()) {
                int idx = c - 'a';
                if (cur.next[idx] == null) cur.next[idx] = new Node();
                cur = cur.next[idx];
            }
            cur.isEnd = true;
        }

        public boolean search(String s) {
            Node node = find(s);
            return node != null && node.isEnd;
        }

        public boolean startsWith(String prefix) {
            return find(prefix) != null;
        }

        private Node find(String s) {
            Node cur = root;
            for (char c : s.toCharArray()) {
                int idx = c - 'a';
                if (cur.next[idx] == null) return null;
                cur = cur.next[idx];
            }
            return cur;
        }
    }

snippet SCC Tarjan Strongly Connected Components
    static class TarjanSCC {
        private final int n;
        private final List<List<Integer>> adj;
        private final int[] dfn, low;
        private final boolean[] inStack;
        private final Deque<Integer> stack = new ArrayDeque<>();
        private int timer = 0;
        public final List<List<Integer>> scc = new ArrayList<>();

        public TarjanSCC(int n, List<List<Integer>> adj) {
            this.n = n;
            this.adj = adj;
            this.dfn = new int[n];
            this.low = new int[n];
            this.inStack = new boolean[n];
            Arrays.fill(dfn, -1);
            for (int i = 0; i < n; i++) {
                if (dfn[i] == -1) dfs(i);
            }
        }

        private void dfs(int u) {
            dfn[u] = low[u] = ++timer;
            stack.push(u);
            inStack[u] = true;
            for (int v : adj.get(u)) {
                if (dfn[v] == -1) {
                    dfs(v);
                    low[u] = Math.min(low[u], low[v]);
                } else if (inStack[v]) {
                    low[u] = Math.min(low[u], dfn[v]);
                }
            }
            if (low[u] == dfn[u]) {
                List<Integer> comp = new ArrayList<>();
                while (true) {
                    int v = stack.pop();
                    inStack[v] = false;
                    comp.add(v);
                    if (u == v) break;
                }
                scc.add(comp);
            }
        }
    }

