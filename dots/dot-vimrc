set nocompatible
filetype plugin indent on
syntax on

set hidden
set autoread
set noswapfile
set backupcopy=yes
if has('persistent_undo')
    set undofile
    set undodir=~/.vim/undo
endif

set number
set relativenumber
set cursorline
set scrolloff=5
set sidescrolloff=3
set colorcolumn=80
set nowrap

set splitbelow
set splitright

set expandtab
set shiftwidth=4
set tabstop=4
set textwidth=80
set nolist
set mouse=a

set ignorecase
set smartcase
set showmatch
set hlsearch

