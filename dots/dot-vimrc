" 4. Custom Legacy Functions (Simplified)
" Sum Visually selected numbers
function! SumVis()
    try
        let l:a_save = @a
        normal! gv"ay
        let @a = substitute(@a,'[^0-9. ]',' ','g')
        let c = 0
        for i in split(@a)
            let c += i
        endfor
        let b = len(split(@a))
        execute "normal! '>o"
        execute "normal! iTotal = " . c . " Count = " . b
    finally
        let @a = l:a_save
    endtry
endfunction
vnoremap <leader>s :<C-u>call SumVis()<cr>

