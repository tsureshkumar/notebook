" Custom Systems Helpers
function! SumVis()
    try
        let l:a_save = @a
        normal! gv"ay
        let @a = substitute(@a,'[^0-9. ]',' ','g')
        let c = 0
        for i in split(@a)
            let c += i
        endfor
        let b = len(split(@a))
        execute "normal! '>o"
        execute "normal! iTotal = " . c . " Count = " . b
    finally
        let @a = l:a_save
    endtry
endfunction
vnoremap <leader>s :<C-u>call SumVis()<cr>

" Competitive Programming layout helper: | |-| layout
" Left pane has name.cpp, top right has name.input, bottom right has name.output.
function! s:GetCpLayoutWins()
    let l:layout = winlayout()
    if l:layout[0] ==# 'row' && len(l:layout[1]) == 2
        let l:left = l:layout[1][0]
        let l:right = l:layout[1][1]
        if l:left[0] ==# 'leaf' && l:right[0] ==# 'col' && len(l:right[1]) == 2
            let l:topright = l:right[1][0]
            let l:bottomright = l:right[1][1]
            if l:topright[0] ==# 'leaf' && l:bottomright[0] ==# 'leaf'
                return [l:left[1], l:topright[1], l:bottomright[1]]
            endif
        endif
    endif
    return []
endfunction

function! s:OpenCpLayout(name)
    let l:name = a:name
    if empty(l:name)
        let l:name = expand('%:p:r')
    else
        let l:name = fnamemodify(l:name, ':r')
    endif
    if empty(l:name)
        let l:name = 'main'
    endif

    let l:wins = s:GetCpLayoutWins()
    if empty(l:wins)
        " Rebuild layout: left pane full height, right pane split horizontally
        only
        let l:win_left = win_getid()
        execute 'rightbelow vsplit'
        let l:win_topright = win_getid()
        execute 'rightbelow split'
        let l:win_bottomright = win_getid()
        let l:wins = [l:win_left, l:win_topright, l:win_bottomright]
    endif

    " Load the files in their respective windows
    call win_gotoid(l:wins[0])
    execute 'edit ' . l:name . '.cpp'

    call win_gotoid(l:wins[1])
    execute 'edit ' . l:name . '.input'

    call win_gotoid(l:wins[2])
    execute 'edit ' . l:name . '.output'

    " Return focus to the code window (left)
    call win_gotoid(l:wins[0])
endfunction

command! -nargs=? -complete=file CP call s:OpenCpLayout(<q-args>)
command! -nargs=? -complete=file CpLayout call s:OpenCpLayout(<q-args>)

