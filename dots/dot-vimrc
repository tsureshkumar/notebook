" Case Switching Utility
function! SwitchCase()
    let l:word = expand('<cword>')
    let l:line = getline('.')
    let l:col = col('.')
    let l:match = matchstrpos(l:line, '\k*\%' . l:col . 'c\k*')
    let l:start_col = l:match[1]
    
    if l:word =~ '[a-z][A-Z]'
        let l:new_word = substitute(l:word, '\([a-z]\)\([A-Z]\)', '\1_\L\2', 'g')
    elseif l:word =~ '_[a-z]'
        let l:new_word = substitute(l:word, '_\([a-z]\)', '\U\1', 'g')
    else
        return
    endif
    
    let l:new_line = l:line[:l:start_col-1] . l:new_word . l:line[l:start_col + len(l:word):]
    call setline('.', l:new_line)
endfunction
nnoremap <leader>s :call SwitchCase()<cr>

