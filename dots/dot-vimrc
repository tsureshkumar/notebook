" Path copying
nnoremap <leader>p :let @+ = expand('%')<cr>
nnoremap <leader>/ :let @+ = expand('%:p')<cr>

" Case Switching Utility
function! SwitchCase()
    let l:word = expand('<cword>')
    let l:line = getline('.')
    let l:col = col('.')
    let l:match = matchstrpos(l:line, '\k*\%' . l:col . 'c\k*')
    let l:start_col = l:match[1]
    
    if l:word =~ '[a-z][A-Z]'
        let l:new_word = substitute(l:word, '\([a-z]\)\([A-Z]\)', '\1_\L\2', 'g')
    elseif l:word =~ '_[a-z]'
        let l:new_word = substitute(l:word, '_\([a-z]\)', '\U\1', 'g')
    else
        return
    endif
    
    let l:new_line = l:line[:l:start_col-1] . l:new_word . l:line[l:start_col + len(l:word):]
    call setline('.', l:new_line)
endfunction
nnoremap <leader>s :call SwitchCase()<cr>

" Print to PDF Utility
function! PrintToPDF()
    let l:file = expand("%:r")
    syntax off
    highlight clear
    highlight Normal ctermfg=black ctermbg=white
    execute "hardcopy > " . l:file . ".ps"
    if executable("ps2pdf")
        call system("ps2pdf -dPDFSETTINGS=/ebook " . l:file . ".ps " . l:file . ".pdf")
        call system("rm " . l:file . ".ps")
        echo "Printed to reduced PDF: " . l:file . ".pdf"
    endif
    syntax on
endfunction
nnoremap <leader>P :call PrintToPDF()<cr>

