function! MakeOrCompile()
    let l:file_dir = expand('%:p:h')
    if filereadable(l:file_dir . '/Makefile') || filereadable(l:file_dir . '/makefile')
        let &l:makeprg = 'make -C %:p:h:S %:t:r'
        make!
    else
        let l:ft = &filetype
        if l:ft ==# 'cpp'
            let &l:makeprg = 'mkdir -p %:p:h/build && g++ -std=c++17 -O2 -g -DDEBUG=1 -Wall -pedantic -Werror -Wreturn-type -Wl,-stack_size,0x10000000 % -lm -o %:p:h/build/%:t:r'
            make!
        elseif l:ft ==# 'c'
            let &l:makeprg = 'mkdir -p %:p:h/build && gcc -O2 -g -Wall -pedantic -Werror -Wreturn-type -Wl,-stack_size,0x10000000 % -lm -o %:p:h/build/%:t:r'
            make!
        else
            echo "No Makefile found in " . l:file_dir . " and filetype '" . l:ft . "' is not supported for standalone compilation."
            return
        endif
    endif
    cwindow
endfunction
nnoremap <leader>m :call MakeOrCompile()<cr>

